{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CueIt",
  "version": "0.2.0-alpha.2",
  "identifier": "com.cueit.desktop",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --dir ../../frontend run dev",
    "beforeBuildCommand": "pnpm --dir ../../frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "CueIt",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
